{
  // 类型检查专用配置：不产出任何文件，不引入构建步骤（后端 .ts 由 Node 原生剥离类型运行）。
  // 目的：用类型系统拦住「调用方参数和签名对不上」这类
  // 静默 bug —— 例如 resolveSourceCalls 漏传 root、trace 邻居节点 kind 恒为 null。
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    // lib/**/*.ts 由 Node 原生剥离类型后直接运行（≥22.18，无构建步骤）。
    // 因此：.mjs 里要能写 `import './textparse.ts'`，且 TS 语法必须是可擦除的
    // （不能用 enum / namespace / 构造函数参数属性 —— erasableSyntaxOnly 会拦住）。
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    // 全量 strict：无隐式 any、无显式 any，strictNullChecks / useUnknownInCatchVariables 也全开。
    // 可空性已在全仓库梳理过：能加守卫的加守卫，必要的断言集中在少数几处并注明理由
    // （如 $canvas / ds() —— 「渲染时自己写上去的属性按存在处理」）。
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "server.ts",
    "bin/**/*.ts",
    "lib/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.mjs",
    "public/app.js"
  ]
}
