{
  // 类型检查专用配置：不产出任何文件，不引入构建步骤（后端 .ts 由 Node 原生剥离类型运行）。
  // 目的（见 TODO.md 的 TS 迁移说明）：用类型系统拦住「调用方参数和签名对不上」这类
  // 静默 bug —— 例如 resolveSourceCalls 漏传 root、trace 邻居节点 kind 恒为 null。
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    // lib/**/*.ts 由 Node 原生剥离类型后直接运行（≥22.18，无构建步骤）。
    // 因此：.mjs 里要能写 `import './textparse.ts'`，且 TS 语法必须是可擦除的
    // （不能用 enum / namespace / 构造函数参数属性 —— erasableSyntaxOnly 会拦住）。
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    // noImplicitAny 已开：全仓库（含前端 app.js 的 checkJs、测试与 DOM 替身）不允许隐式 any，
    // 也不再有显式 any。仍关 strict（strictNullChecks off）——逐个梳理可空性是下一阶段的事，
    // 它不影响「参数个数 / 属性名 / 形状对不上」这类真错。
    "strict": false,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "server.ts",
    "bin/**/*.ts",
    "lib/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.mjs",
    "public/app.js"
  ]
}
