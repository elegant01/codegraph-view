{
  "name": "codegraph-view",
  "version": "1.2.0",
  "description": "Interactive call-graph visualizer for a CodeGraph index — bundles every codegraph command plus a `view` subcommand",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elegant01/codegraph-view.git"
  },
  "bin": {
    "cgv": "bin/cgv.ts",
